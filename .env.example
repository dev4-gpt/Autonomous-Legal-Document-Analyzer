# Legal Document Analyzer Configuration
# Copy this file to .env and configure your settings

# Environment
ENVIRONMENT=development  # development, production, testing

# LLM Configuration
LLM_PROVIDER=ollama  # ollama, openai, anthropic
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_MODEL=llama3
OPENAI_MODEL=gpt-3.5-turbo
ANTHROPIC_MODEL=claude-3-opus-20240229

# Vector Store Configuration
VECTOR_DB_TYPE=faiss  # faiss or chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Processing Configuration
MAX_FILE_SIZE_MB=50
BATCH_SIZE=10
MAX_WORKERS=4

# Database Configuration
DATABASE_URL=sqlite:///data/legal_analyzer.db

# UI Configuration
APP_TITLE=Autonomous Legal Document Analyzer
APP_DESCRIPTION=Enterprise AI-powered legal document analysis
THEME=dark

# Security Configuration
SECRET_KEY=your-secret-key-change-in-production
SESSION_TIMEOUT=3600

# Logging Configuration
LOG_LEVEL=INFO

# Performance Configuration
CACHE_TTL=3600
